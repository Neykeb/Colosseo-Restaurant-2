{
  "name": "ristorante-colosseo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --import tsx scripts/prerender.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "server": "node --env-file=.env --import tsx server/src/server.ts",
    "db:seed:development": "node --env-file=.env --import tsx server/src/scripts/seed-development.ts",
    "db:check": "node --env-file=.env --import tsx server/src/scripts/check-database.ts",
    "db:check:test": "node --env-file=.env --env-file=.env.test --import tsx server/src/scripts/check-test-database.ts",
    "db:migrate": "node --env-file=.env --import tsx server/src/scripts/migrate.ts up",
    "db:migrate:status": "node --env-file=.env --import tsx server/src/scripts/migrate.ts status",
    "db:migrate:down": "node --env-file=.env --import tsx server/src/scripts/migrate.ts down",
    "db:migrate:test": "node --env-file=.env --env-file=.env.test --import tsx server/src/scripts/migrate.ts up"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "latest",
    "@phosphor-icons/react": "latest",
    "@tanstack/react-router": "^1.170.46",
    "express": "^5.3.0",
    "gsap": "latest",
    "i18next": "latest",
    "isbot": "^5",
    "lenis": "^1.3.27",
    "mongoose": "^9.11.4",
    "motion": "^14.6.0",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.18.0",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
