# Server only. Copy this file to .env and never commit real credentials.
# URL-encode reserved password characters, for example # as %23.
NODE_ENV=development
PORT=3000
# Optional only when port 3000 is already occupied during local development.
API_PROXY_TARGET=http://127.0.0.1:3000
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_OWNER_USER_ID=user_replace_with_clerk_user_id
CLERK_OWNER_DISPLAY_NAME=Restaurant Owner
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=colosseo
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
RESEND_API_KEY=re_replace_with_sending_only_key
RESEND_FROM_EMAIL=Ristorante Colosseo <reservierung@example.com>
RESTAURANT_NOTIFICATION_EMAIL=restaurant@example.com
